---
// Fallow dup:32f5b325: the card grid in this page mirrors LogicModules.astro by design.
// See the matching comment in src/components/sections/LogicModules.astro.
export const prerender = true;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';
import LogicCard from '../../../components/cards/LogicCard.astro';
import PaginationNav from '../../../components/ui/PaginationNav.astro';
import { buildPagePaths, resolvePage } from '../../../utils/pagination';
import { MODULES_PAGE_SIZE } from '../../../constants/pagination';
import { getSortedLogicModules } from '../../../utils/latest';

export async function getStaticPaths() {
  const sortedModules = await getSortedLogicModules();
  return buildPagePaths(sortedModules.length, MODULES_PAGE_SIZE);
}

const sortedModules = await getSortedLogicModules();

const page = resolvePage(sortedModules, Astro.params.page, MODULES_PAGE_SIZE, '/logic-modules');
if (!page) {
  return Astro.rewrite('/404/');
}

const archivePath = '/logic-modules/';
const canonicalPath = page.currentPage === 1 ? archivePath : `/logic-modules/page/${page.currentPage}/`;
---

<BaseLayout
  title={`Logic Modules - Page ${page.currentPage} | Philosophy Spread`}
  description={`Browse page ${page.currentPage} of logic modules covering argument structure, reasoning, and formal logic fundamentals.`}
  keywords={['logic modules', 'formal logic', 'reasoning skills', 'critical reasoning']}
  canonical={canonicalPath}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Logic Modules', url: archivePath },
    ...(page.currentPage > 1 ? [{ name: `Page ${page.currentPage}`, url: canonicalPath }] : []),
  ]}
>
  <Header />
  
  <main id="main-content" class="pt-32 px-6 md:px-12 pb-20">
    <header class="max-w-7xl mx-auto mb-16">
      <div class="font-label text-xs text-primary mb-4 tracking-[0.2em] uppercase">[ Foundation ]</div>
      <h1 class="text-6xl md:text-8xl font-bold italic tracking-tighter text-secondary mb-6">Logic Modules</h1>
      <p class="max-w-2xl text-xl text-on-surface-variant leading-relaxed font-body">
        Master the fundamentals of formal logic, reasoning, and cognitive defense. 
      </p>
      <br/>
      <div class="font-label text-xs text-primary mb-4 tracking-[0.2em] uppercase">Page {page.currentPage} of {page.lastPage}.</div>
    </header>

    <section class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {page.items.map((module) => (
          <a href={`/logic-modules/${module.id}/`} class="block group no-underline hover:no-underline focus:no-underline">
            <LogicCard 
              moduleNumber={module.data.moduleNumber}
              title={module.data.title} 
              description={module.data.description} 
            />
          </a>
        ))}
      </div>
      
      <PaginationNav page={page} prevLabel="Previous" nextLabel="Next" extraLinkClass="no-underline hover:no-underline focus:no-underline" />
    </section>
  </main>

  <Footer />
</BaseLayout>
