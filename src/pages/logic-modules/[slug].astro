---
export const prerender = true;

import { render, type CollectionEntry } from 'astro:content';
import { getSortedLogicModules } from '../../utils/latest';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReadingProgressBar from '../../components/ui/ReadingProgressBar.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import TruthTable from '../../components/mdx/TruthTable.astro';
import FormalProof from '../../components/mdx/FormalProof.astro';
import InteractiveQuiz from '../../components/mdx/InteractiveQuiz.astro';
import Blockquote from '../../components/mdx/Blockquote.astro';
import Callout from '../../components/mdx/Callout.astro';
import Prose from '../../components/ui/Prose.astro';
import { absoluteSiteUrl, SITE_NAME } from '../../utils/seo';
import { getSiteUrl } from '../../utils/site';

export async function getStaticPaths() {
  const sortedModules = await getSortedLogicModules();
  return sortedModules.map((module: CollectionEntry<'logicModules'>, index: number) => ({
    params: { slug: module.id },
    props: {
      currentModule: module,
      prevModule: index > 0 ? sortedModules[index - 1] : null,
      nextModule: index < sortedModules.length - 1 ? sortedModules[index + 1] : null,
      moduleByNumber: Object.fromEntries(
        sortedModules.map((m) => [m.data.moduleNumber, { id: m.id }]),
      ) as Record<string, { id: string }>,
    },
  }));
}

const { currentModule, prevModule, nextModule, moduleByNumber } = Astro.props as {
  currentModule: CollectionEntry<'logicModules'>;
  prevModule: CollectionEntry<'logicModules'> | null;
  nextModule: CollectionEntry<'logicModules'> | null;
  moduleByNumber: Record<string, { id: string }>;
};

const { Content } = await render(currentModule);

const siteUrl = getSiteUrl(Astro.site);
const moduleUrl = absoluteSiteUrl(Astro.url.pathname, siteUrl);
const moduleStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  '@id': `${moduleUrl}#learning-resource`,
  name: currentModule.data.title,
  description: currentModule.data.description,
  url: moduleUrl,
  inLanguage: 'en-US',
  learningResourceType: 'Lesson',
  educationalLevel: currentModule.data.difficulty,
  isPartOf: { '@id': `${siteUrl.toString()}#website` },
  provider: {
    '@type': 'Organization',
    name: SITE_NAME,
    url: siteUrl.toString(),
  },
};

const components = {
  TruthTable,
  FormalProof,
  InteractiveQuiz,
  Blockquote,
  Callout,
};
---

<BaseLayout
  title={`${currentModule.data.title} | Logic Modules`}
  description={currentModule.data.description}
  keywords={['logic module', 'reasoning', 'critical thinking', currentModule.data.category, currentModule.data.difficulty]}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Logic Modules', url: '/logic-modules/' },
    { name: currentModule.data.title, url: moduleUrl },
  ]}
  structuredData={moduleStructuredData}
>
  <ReadingProgressBar />
  <Header />
  
  <main id="main-content" class="pt-32 px-6 md:px-12 pb-20 max-w-4xl mx-auto">
    <article>
      <header class="mb-16 border-b-2 border-secondary pb-12">
        <div class="flex items-center justify-between mb-6">
          <span class="font-label text-sm text-primary font-bold tracking-[0.2em] uppercase">
            [ {currentModule.data.moduleNumber} ]
          </span>
          <span class="font-label text-xs border-2 border-secondary px-3 py-1 uppercase tracking-widest text-secondary">
            {currentModule.data.difficulty}
          </span>
        </div>
        <h1 class="text-5xl md:text-7xl font-bold italic tracking-tighter text-secondary mb-6">
          {currentModule.data.title}
        </h1>
        <p class="text-xl text-on-surface-variant leading-relaxed font-body">
          {currentModule.data.description}
        </p>
        
        {currentModule.data.prerequisites.length > 0 && (
          <div class="mt-8 p-4 bg-surface-container-low border-l-4 border-secondary">
            <h3 class="font-label text-xs uppercase tracking-widest text-secondary mb-2">Prerequisites:</h3>
            <ul class="flex flex-wrap gap-4">
              {currentModule.data.prerequisites.map((prereq: string) => {
                const prereqModule = moduleByNumber[prereq];
                return prereqModule
                  ? <li class="font-body text-sm italic"><a href={`/logic-modules/${prereqModule.id}/`} class="underline hover:text-primary transition-colors">{prereq}</a></li>
                  : <li class="font-body text-sm italic">{prereq}</li>;
              })}
            </ul>
          </div>
        )}
      </header>

      <Prose variant="logicModule">
        <Content components={components} />
      </Prose>
      
      <nav class="mt-20 md:mt-24 pt-8 border-t-2 border-secondary flex gap-3 sm:gap-4 md:gap-8">
        {prevModule ? (
          <a href={`/logic-modules/${prevModule.id}/`} class="group flex flex-1 min-w-0 h-[8.5rem] sm:h-[9.25rem] md:h-[10rem] flex-col justify-between items-start p-3 sm:p-4 md:p-6 border-2 border-secondary/30 hover:border-secondary bg-surface-container-low/30 transition-colors">
            <span class="font-label text-[9px] sm:text-[10px] uppercase tracking-widest text-primary">&lt;- Previous Module</span>
            <span class="font-headline text-base sm:text-lg md:text-2xl leading-tight break-words group-hover:italic transition-all">{prevModule.data.title}</span>
          </a>
        ) : (
          <div class="flex-1 h-[8.5rem] sm:h-[9.25rem] md:h-[10rem] border-2 border-secondary/10 bg-surface-container-low/10"></div>
        )}
        
        {nextModule ? (
          <a href={`/logic-modules/${nextModule.id}/`} class="group flex flex-1 min-w-0 h-[8.5rem] sm:h-[9.25rem] md:h-[10rem] flex-col justify-between items-start md:items-end text-left md:text-right p-3 sm:p-4 md:p-6 border-2 border-secondary/30 hover:border-secondary bg-surface-container-low/30 transition-colors">
            <span class="font-label text-[9px] sm:text-[10px] uppercase tracking-widest text-primary">Next Module -&gt;</span>
            <span class="font-headline text-base sm:text-lg md:text-2xl leading-tight break-words group-hover:italic transition-all">{nextModule.data.title}</span>
          </a>
        ) : (
          <div class="flex-1 h-[8.5rem] sm:h-[9.25rem] md:h-[10rem] border-2 border-secondary/10 bg-surface-container-low/10"></div>
        )}
      </nav>
    </article>
  </main>

  <Footer />
</BaseLayout>
