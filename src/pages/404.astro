---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import HeroRightPane from '../components/sections/HeroRightPane.astro';
import Icon from '../components/ui/Icon.astro';
import { getLatestContent } from '../utils/latest';
import { getCollection } from 'astro:content';

const [logicModules, bits, essays] = await Promise.all([
  getCollection('logicModules'),
  getCollection('bits'),
  getCollection('essays'),
]);

const { latestLogic, latestBit, latestEssay } = await getLatestContent(logicModules, bits, essays);

const requestedPath = Astro.url.pathname;
---

<BaseLayout
  title="404 | Content Not Found | Philosophy Spread"
  description="The page you were looking for could not be found. Explore the latest logic modules, idea bits, and essays from Philosophy Spread."
  keywords={['404', 'not found', 'philosophy spread']}
  canonical={null}
  noindex
  includeSiteSchema={false}
>
  <Header />

  <main id="main-content" class="pt-20">
    <section class="min-h-[calc(100dvh-80px)] grid grid-cols-1 md:grid-cols-10 border-b-2 border-secondary">
      <div class="md:col-span-6 flex flex-col justify-center p-8 md:p-12 lg:p-24 border-b-2 md:border-b-0 md:border-r-2 border-secondary bg-surface-container-lowest">
        <span class="font-label text-xs uppercase tracking-widest text-primary mb-8">
          [ ERROR 404 · ROUTE NOT RESOLVED ]
        </span>

        <h1 class="font-headline text-7xl md:text-8xl lg:text-9xl leading-[0.9] tracking-tighter text-on-surface mb-8">
          <span class="block italic">I wandered,</span>
          <span class="block">therefore I am lost.</span>
        </h1>

        <p class="font-headline text-2xl md:text-3xl italic text-on-surface mb-6 max-w-xl">
          The page you sought has slipped beyond the margin of our manuscript.
        </p>

        <p class="font-body text-base md:text-lg opacity-80 mb-10 max-w-xl">
          We couldn't locate
          <code class="font-label text-sm bg-surface-container px-2 py-1 mx-1 break-all">{requestedPath}</code>
          within Philosophy Spread. The link may be outdated, mistyped, or simply uncharted.
        </p>

        <div class="flex flex-wrap gap-4 font-label text-sm">
          <a href="/" class="hover:text-primary transition-colors italic inline-flex items-center gap-2">
            <Icon name="arrow_back" class="h-4 w-4" />
            01. RETURN HOME
          </a>
          <a href="/essays/" class="hover:text-primary transition-colors italic">
            02. BROWSE ESSAYS
          </a>
          <a href="/contribute/" class="hover:text-primary transition-colors italic">
            03. CONTRIBUTE
          </a>
        </div>


      </div>

      <!-- Right pane: latest content (mirrors HeroRightPane) -->
      <HeroRightPane latestLogic={latestLogic} latestBit={latestBit} latestEssay={latestEssay} />
    </section>
  </main>

  <Footer />
</BaseLayout>
