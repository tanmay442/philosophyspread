---
export const prerender = true;

import { getCollection, render } from 'astro:content';
import ContentPageLayout from '../layouts/ContentPageLayout.astro';
import Blockquote from '../components/mdx/Blockquote.astro';

const pages = await getCollection('pages');
const contributePage = pages.find((entry) => entry.id === 'contribute');

if (!contributePage) {
  return Astro.rewrite('/404/');
}

const { Content } = await render(contributePage);
---

<ContentPageLayout
  title={contributePage.data.title}
  description="Contribute essays, Idea Bits, and constructive feedback to help build a thoughtful philosophy and logic community."
  keywords={['contribute', 'philosophy essays', 'logic modules', 'critical thinking community']}
  lastUpdated={contributePage.data.lastUpdated}
>
  <Content components={{ Blockquote }} />
</ContentPageLayout>
