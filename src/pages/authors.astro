---
export const prerender = true;

import { getCollection, render } from 'astro:content';
import ContentPageLayout from '../layouts/ContentPageLayout.astro';
import Blockquote from '../components/mdx/Blockquote.astro';

const pages = await getCollection('pages');
const authorsPage = pages.find((entry) => entry.id === 'authors');

if (!authorsPage) {
  return Astro.rewrite('/404/');
}

const { Content } = await render(authorsPage);
---

<ContentPageLayout
  title={authorsPage.data.title}
  description="Browse the listed authors at Philosophy Spread and access their provided profile links."
  keywords={['authors', 'philosophy spread', 'contributors']}
  lastUpdated={authorsPage.data.lastUpdated}
>
  <Content components={{ Blockquote }} />
</ContentPageLayout>
