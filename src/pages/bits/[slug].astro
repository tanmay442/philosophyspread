---
export const prerender = true;

import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReadingProgressBar from '../../components/ui/ReadingProgressBar.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Callout from '../../components/mdx/Callout.astro';
import Icon from '../../components/ui/Icon.astro';
import Prose from '../../components/ui/Prose.astro';
import { truncateText, stripMarkdown } from '../../utils/text';
import { absoluteSiteUrl, SITE_NAME } from '../../utils/seo';
import { getSiteUrl } from '../../utils/site';

export async function getStaticPaths() {
  const bits = await getCollection('bits');
  return bits.map((bit: CollectionEntry<'bits'>) => ({
    params: { slug: bit.id },
    props: { bit },
  }));
}

const { bit: currentBit } = Astro.props as { bit: CollectionEntry<'bits'> };

const { Content } = await render(currentBit);
// Strip markdown emphasis/quote markers before truncating so literal
// `*`/`_` characters don't leak into the meta description / SERP snippet.
const bitDescription = truncateText(stripMarkdown(currentBit.data.content), 157);
const siteUrl = getSiteUrl(Astro.site);
const bitUrl = absoluteSiteUrl(Astro.url.pathname, siteUrl);
const authorUrl = currentBit.data.author === 'Tanmay Goel'
  ? 'https://x.com/TanmayGoel442'
  : undefined;
const bitStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${bitUrl}#article`,
  headline: `Idea Bit ${currentBit.data.bitNumber}`,
  description: bitDescription,
  datePublished: currentBit.data.timestamp.toISOString(),
  articleSection: currentBit.data.category,
  inLanguage: 'en-US',
  author: {
    '@type': 'Person',
    name: currentBit.data.author,
    ...(authorUrl ? { url: authorUrl } : {}),
  },
  publisher: {
    '@type': 'Organization',
    name: SITE_NAME,
    url: siteUrl.toString(),
  },
  mainEntityOfPage: { '@id': `${bitUrl}#webpage` },
};
---

<BaseLayout
  title={`Bit ${currentBit.data.bitNumber} | Philosophy Spread`}
  description={bitDescription}
  keywords={['philosophy bit', 'Idea-Bits', currentBit.data.category, 'thought experiment']}
  type="article"
  publishedTime={currentBit.data.timestamp.toISOString()}
  author={currentBit.data.author}
  authorUrl={authorUrl}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Idea-Bits', url: '/bits/' },
    { name: `Bit ${currentBit.data.bitNumber}`, url: bitUrl },
  ]}
  structuredData={bitStructuredData}
>
  <ReadingProgressBar />
  <Header />
  
  <main id="main-content" class="pt-32 px-6 md:px-12 pb-20 max-w-3xl mx-auto min-h-[calc(100vh-200px)]">
    <article class="relative">
      <header class="mb-12 border-b-2 border-secondary pb-8">
        <div class="flex items-center gap-4 mb-6">
          <span class="bg-primary text-on-primary font-label text-xs px-3 py-1 uppercase tracking-widest">
            Bit {currentBit.data.bitNumber}
          </span>
          <span class="font-label text-xs text-secondary uppercase tracking-widest">
            {currentBit.data.category}
          </span>
        </div>
        <time datetime={currentBit.data.timestamp.toISOString()} class="font-label text-sm text-on-surface-variant opacity-80 uppercase tracking-widest">
          {currentBit.data.timestamp.toLocaleString('en-US', { timeZone: 'UTC', dateStyle: 'long', timeStyle: 'short' })} UTC
        </time>
        <div class="mt-3 font-label text-xs text-on-surface-variant uppercase tracking-widest">
          By {currentBit.data.author}
        </div>
      </header>
      
      <Prose variant="bit">
        <Content components={{ Callout }} />
      </Prose>
      
      <div class="flex justify-center border-t-2 border-secondary pt-12">
        <a href="/bits/" class="font-label text-sm text-primary uppercase tracking-widest hover:text-secondary transition-colors flex items-center group">
          <Icon name="arrow_back" class="mr-2 h-4 w-4 group-hover:-translate-x-1 transition-transform" />
          Back to Feed
        </a>
      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>
