---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReadingProgressBar from '../../components/ui/ReadingProgressBar.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Callout from '../../components/mdx/Callout.astro';
import Icon from '../../components/ui/Icon.astro';
import Prose from '../../components/ui/Prose.astro';
import { truncateText, stripMarkdown } from '../../utils/text';

const bitSlug = Astro.params.slug;

if (bitSlug && /^\d+$/.test(bitSlug)) {
  return Astro.redirect(`/bits/page/${bitSlug}`, 301);
}

const bits = await getCollection('bits');
const currentBit = bits.find((entry) => entry.id === bitSlug);

if (!currentBit) {
  return Astro.rewrite('/404');
}

const { Content } = await render(currentBit);
// Strip markdown emphasis/quote markers before truncating so literal
// `*`/`_` characters don't leak into the meta description / SERP snippet.
const bitDescription = truncateText(stripMarkdown(currentBit.data.content), 157);
---

<BaseLayout
  title={`Bit ${currentBit.data.bitNumber} | Philosophy Spread`}
  description={bitDescription}
  keywords={['philosophy bit', 'Idea-Bits', currentBit.data.category, 'thought experiment']}
>
  <ReadingProgressBar />
  <Header />
  
  <main class="pt-32 px-6 md:px-12 pb-20 max-w-3xl mx-auto min-h-[calc(100vh-200px)]">
    <article class="relative">
      <header class="mb-12 border-b-2 border-secondary pb-8">
        <div class="flex items-center gap-4 mb-6">
          <span class="bg-primary text-on-primary font-label text-xs px-3 py-1 uppercase tracking-widest">
            Bit {currentBit.data.bitNumber}
          </span>
          <span class="font-label text-xs text-secondary uppercase tracking-widest">
            {currentBit.data.category}
          </span>
        </div>
        <time datetime={currentBit.data.timestamp.toISOString()} class="font-label text-sm text-on-surface-variant opacity-80 uppercase tracking-widest">
          {currentBit.data.timestamp.toLocaleString('en-US', { timeZone: 'UTC', dateStyle: 'long', timeStyle: 'short' })} UTC
        </time>
        <div class="mt-3 font-label text-xs text-on-surface-variant uppercase tracking-widest">
          By {currentBit.data.author}
        </div>
      </header>
      
      <Prose variant="bit">
        <Content components={{ Callout }} />
      </Prose>
      
      <div class="flex justify-center border-t-2 border-secondary pt-12">
        <a href="/bits/page/1" class="font-label text-sm text-primary uppercase tracking-widest hover:text-secondary transition-colors flex items-center group">
          <Icon name="arrow_back" class="mr-2 h-4 w-4 group-hover:-translate-x-1 transition-transform" />
          Back to Feed
        </a>
      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>
