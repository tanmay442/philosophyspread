---
export const prerender = true;

import { getCollection, render } from 'astro:content';
import ContentPageLayout from '../layouts/ContentPageLayout.astro';

const pages = await getCollection('pages');
const termsPage = pages.find((entry) => entry.id === 'terms');

if (!termsPage) {
  return Astro.rewrite('/404/');
}

const { Content } = await render(termsPage);
---

<ContentPageLayout
  title={termsPage.data.title}
  description="Read Philosophy Spread's terms of service and privacy policy, including content licensing, email list terms, and data handling details."
  keywords={['terms of service', 'privacy policy', 'philosophy spread', 'content license']}
  lastUpdated={termsPage.data.lastUpdated}
>
  <Content />
</ContentPageLayout>
