---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Icon from '../components/ui/Icon.astro';
import Prose from '../components/ui/Prose.astro';

const pages = await getCollection('pages');
const termsPage = pages.find((entry) => entry.id === 'terms');

if (!termsPage) {
  return Astro.rewrite('/404');
}

const { Content } = await render(termsPage);
const lastUpdated = termsPage.data.lastUpdated.toLocaleDateString('en-US', {
  timeZone: 'UTC',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={`${termsPage.data.title} | Philosophy Spread`}
  description="Read Philosophy Spread's terms of service and privacy policy, including content licensing, email list terms, and data handling details."
  keywords={['terms of service', 'privacy policy', 'philosophy spread', 'content license']}
>
  <Header />
  
  <main class="pt-32 px-6 md:px-12 pb-20 max-w-4xl mx-auto">
    <article>
      <header class="mb-12">
        <a href="/" class="inline-flex items-center gap-2 text-primary hover:text-secondary transition-colors mb-6 font-label text-xs uppercase tracking-widest">
          <Icon name="arrow_back" class="h-4 w-4" />
          Back to Home
        </a>
        
        <h1 class="text-4xl md:text-6xl font-bold italic tracking-tighter text-secondary mb-4">
          {termsPage.data.title}
        </h1>
        
        <p class="text-on-surface-variant leading-relaxed font-body">
          Last Updated: {lastUpdated}
        </p>
      </header>

      <Prose variant="page">
        <Content />
      </Prose>
    </article>
  </main>

  <Footer />
</BaseLayout>
