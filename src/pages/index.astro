---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Hero from '../components/sections/Hero.astro';
import LogicModules from '../components/sections/LogicModules.astro';
import DailyBits from '../components/sections/DailyBits.astro';
import Essays from '../components/sections/Essays.astro';
import GetInvolved from '../components/sections/GetInvolved.astro';
import Footer from '../components/layout/Footer.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const [logicModules, bits, essays] = await Promise.all([
  getCollection('logicModules'),
  getCollection('bits'),
  getCollection('essays'),
]);

const latestBy = <T,>(items: T[], compareFn: (a: T, b: T) => number): T | undefined => {
  if (!items.length) {
    return undefined;
  }

  return items.slice(1).reduce(
    (latestItem, item) => (compareFn(item, latestItem) < 0 ? item : latestItem),
    items[0],
  );
};

const logicModuleCards = [...logicModules]
  .sort((a, b) => a.data.moduleNumber.localeCompare(b.data.moduleNumber))
  .slice(0, 4);

const dailyBitCards = [...bits]
  .sort((a: CollectionEntry<'bits'>, b: CollectionEntry<'bits'>) => b.data.timestamp.valueOf() - a.data.timestamp.valueOf())
  .slice(0, 6);

const latestLogic = latestBy(
  logicModules,
  (a: CollectionEntry<'logicModules'>, b: CollectionEntry<'logicModules'>) =>
    b.data.moduleNumber.localeCompare(a.data.moduleNumber),
);

const latestBit = latestBy(
  bits,
  (a: CollectionEntry<'bits'>, b: CollectionEntry<'bits'>) =>
    b.data.timestamp.valueOf() - a.data.timestamp.valueOf(),
);

const latestEssay = latestBy(
  essays,
  (a: CollectionEntry<'essays'>, b: CollectionEntry<'essays'>) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featuredEssay = essays.find((essay) => essay.data.featured) ?? essays[0];
const trendingEssays = featuredEssay
  ? essays
      .filter((essay) => essay.id !== featuredEssay.id)
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
      .slice(0, 3)
  : [];
---

<BaseLayout
  title="Philosophy Spread | The Logical Manuscript"
  description="Explore philosophy essays, logic modules, and Idea Bits designed to sharpen reasoning and deepen reflection."
  keywords={['philosophy', 'logic', 'critical thinking', 'essays', 'reasoning']}
>
  <Header />
  <main class="pt-20">
    <Hero latestLogic={latestLogic} latestBit={latestBit} latestEssay={latestEssay} />
    <LogicModules logicModules={logicModuleCards} />
    <DailyBits bits={dailyBitCards} />
    <Essays featuredEssay={featuredEssay} trendingEssays={trendingEssays} />
    <GetInvolved />
  </main>
  <Footer />
</BaseLayout>
