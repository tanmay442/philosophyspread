---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Hero from '../components/sections/Hero.astro';
import LogicModules from '../components/sections/LogicModules.astro';
import DailyBits from '../components/sections/DailyBits.astro';
import Essays from '../components/sections/Essays.astro';
import GetInvolved from '../components/sections/GetInvolved.astro';
import Footer from '../components/layout/Footer.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { getLatestContent, getSortedLogicModules } from '../utils/latest';

const [logicModules, bits, essays] = await Promise.all([
  getSortedLogicModules(),
  getCollection('bits'),
  getCollection('essays'),
]);

const { latestLogic, latestBit, latestEssay } = await getLatestContent(logicModules, bits, essays);

const logicModuleCards = logicModules.slice(0, 4);

const dailyBitCards = [...bits]
  .sort((a: CollectionEntry<'bits'>, b: CollectionEntry<'bits'>) => b.data.timestamp.valueOf() - a.data.timestamp.valueOf())
  .slice(0, 6);

// Pick the most-recent featured essay deterministically. `.find()` would
// silently return whichever featured entry comes first in collection
// order if two are ever flagged, so we sort the featured set by pubDate.
const featuredEssay =
  essays
    .filter((essay) => essay.data.featured)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0]
  ?? essays[0];

// Guard against an empty essays collection: without this, accessing
// featuredEssay.id below would throw and 500 the homepage.
const trendingEssays = featuredEssay
  ? essays
      .filter((essay) => essay.id !== featuredEssay.id)
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
      .slice(0, 3)
  : [];
---

<BaseLayout
  title="Philosophy Spread | The Logical Manuscript"
  description="Explore philosophy essays, logic modules, and Idea Bits designed to sharpen reasoning and deepen reflection."
  keywords={['philosophy', 'logic', 'critical thinking', 'essays', 'reasoning']}
>
  <Header />
  <main class="pt-20">
    <Hero latestLogic={latestLogic} latestBit={latestBit} latestEssay={latestEssay} />
    <LogicModules logicModules={logicModuleCards} />
    <DailyBits bits={dailyBitCards} />
    <Essays featuredEssay={featuredEssay} trendingEssays={trendingEssays} />
    <GetInvolved />
  </main>
  <Footer />
</BaseLayout>
