---
export const prerender = true;

import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';
import EssayCard from '../../../components/cards/EssayCard.astro';
import PaginationNav from '../../../components/ui/PaginationNav.astro';
import { buildPagePaths, resolvePage } from '../../../utils/pagination';
import { ESSAYS_PAGE_SIZE } from '../../../constants/pagination';

export async function getStaticPaths() {
  const essays = await getCollection('essays');
  const sortedEssays = [...essays].sort(
    (a: CollectionEntry<'essays'>, b: CollectionEntry<'essays'>) =>
      b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );
  return buildPagePaths(sortedEssays.length, ESSAYS_PAGE_SIZE);
}

const essays = await getCollection('essays');
const sortedEssays = [...essays].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const page = resolvePage(sortedEssays, Astro.params.page, ESSAYS_PAGE_SIZE, '/essays');
if (!page) {
  return Astro.rewrite('/404/');
}

const archivePath = '/essays/';
const canonicalPath = page.currentPage === 1 ? archivePath : `/essays/page/${page.currentPage}/`;
---

<BaseLayout
  title={`Essays - Page ${page.currentPage} | Philosophy Spread`}
  description={`Browse page ${page.currentPage} of Philosophy Spread essays: long-form philosophical writing on logic, ethics, and critical thought.`}
  keywords={['philosophy essays', 'critical thinking', 'long-form philosophy', 'logic']}
  canonical={canonicalPath}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Essays', url: archivePath },
    ...(page.currentPage > 1 ? [{ name: `Page ${page.currentPage}`, url: canonicalPath }] : []),
  ]}
>
  <Header />
  
  <main id="main-content" class="pt-32 px-6 md:px-12 pb-20">
    <header class="max-w-7xl mx-auto mb-16">
      <div class="font-label text-xs text-secondary mb-4 tracking-[0.2em] uppercase">[ The Archives ]</div>
      <h1 class="text-6xl md:text-8xl font-bold italic tracking-tighter text-secondary mb-6">Essays</h1>
      <p class="max-w-2xl text-xl text-on-surface-variant leading-relaxed font-body">
        Long-form explorations of contemporary issues through classical lenses. 
      </p>
      <br/>
      <div class="font-label text-xs text-secondary mb-4 tracking-[0.2em] uppercase">Page {page.currentPage} of {page.lastPage}.</div>
    </header>

    <section class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {page.items.map((essay) => (
          <EssayCard 
            tag={`[ ${essay.data.category} ]`}
            title={essay.data.title}
            description={essay.data.description}
            date={essay.data.pubDate}
            imageSrc={essay.data.imageSrc}
            imageAlt={essay.data.imageAlt}
            href={`/essays/${essay.id}/`}
          />
        ))}
      </div>
      
      <PaginationNav page={page} prevLabel="Newer" nextLabel="Older" />
    </section>
  </main>

  <Footer />
</BaseLayout>
