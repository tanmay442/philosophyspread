---
export const prerender = true;

import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReadingProgressBar from '../../components/ui/ReadingProgressBar.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Blockquote from '../../components/mdx/Blockquote.astro';
import { getSiteUrl } from '../../utils/site';
import { truncateText } from '../../utils/text';
import Prose from '../../components/ui/Prose.astro';
import EditorialImage from '../../components/ui/EditorialImage.astro';
import { absoluteSiteUrl, getImageDimensions, SITE_NAME } from '../../utils/seo';
import socialBoredom from '../../assets/social/boredom.jpg';
import socialChoice from '../../assets/social/choice.jpg';
import socialConsciousness from '../../assets/social/consciousness.jpg';
import socialLogic from '../../assets/social/logic.jpg';
import socialMetaphysics from '../../assets/social/metaphysics.jpg';
import socialMorality from '../../assets/social/morality.jpg';

export async function getStaticPaths() {
  const essays = await getCollection('essays');
  return essays.map((essay: CollectionEntry<'essays'>) => ({
    params: { slug: essay.id },
    props: { essay },
  }));
}

const { essay } = Astro.props as { essay: CollectionEntry<'essays'> };

const { Content } = await render(essay);
const siteUrl = getSiteUrl(Astro.site);
const essayUrl = absoluteSiteUrl(Astro.url.pathname, siteUrl);
const sourceImagePath = essay.data.imageSrc;
const socialImages: Record<string, { src: string; width: number; height: number }> = {
  '/boredom.png': socialBoredom,
  '/choice.avif': socialChoice,
  '/consciousness.avif': socialConsciousness,
  '/logic.avif': socialLogic,
  '/metaphysics.avif': socialMetaphysics,
  '/morality.avif': socialMorality,
};
const socialImage = socialImages[sourceImagePath];
const socialImagePath = socialImage?.src ?? sourceImagePath;
const socialImageUrl = socialImagePath.startsWith('http://') || socialImagePath.startsWith('https://')
  ? socialImagePath
  : new URL(socialImagePath, siteUrl).toString();
const socialImageDimensions = socialImage ?? getImageDimensions(sourceImagePath);
const authorUrl = essay.data.author === 'Tanmay Goel'
  ? 'https://x.com/TanmayGoel442'
  : undefined;

// Truncate the meta description to fit SERP snippets (~158 chars) while
// the full description is still rendered in the article <header> body.
const metaDescription = truncateText(essay.data.description, 158);

const articleStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${essayUrl}#article`,
  headline: essay.data.title,
  description: essay.data.description,
  datePublished: essay.data.pubDate.toISOString(),
  articleSection: essay.data.category,
  keywords: essay.data.tags,
  inLanguage: 'en-US',
  author: {
    '@type': 'Person',
    name: essay.data.author,
    ...(authorUrl ? { url: authorUrl } : {}),
  },
  image: {
    '@type': 'ImageObject',
    url: socialImageUrl,
    ...(socialImageDimensions ?? {}),
  },
  mainEntityOfPage: { '@id': `${essayUrl}#webpage` },
  publisher: {
    '@type': 'Organization',
    name: SITE_NAME,
    url: siteUrl.toString(),
    logo: {
      '@type': 'ImageObject',
      url: new URL('/favicon.svg', siteUrl).toString(),
    },
  },
};

const components = {
  Blockquote,
};
---

<BaseLayout
  title={`${essay.data.title} | Philosophy Spread`}
  description={metaDescription}
  image={socialImagePath}
  imageAlt={essay.data.imageAlt}
  imageWidth={socialImageDimensions?.width}
  imageHeight={socialImageDimensions?.height}
  keywords={['philosophy essay', 'critical thinking', essay.data.category, ...essay.data.tags]}
  type="article"
  publishedTime={essay.data.pubDate.toISOString()}
  author={essay.data.author}
  authorUrl={authorUrl}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Essays', url: '/essays/' },
    { name: essay.data.title, url: essayUrl },
  ]}
  structuredData={articleStructuredData}
>
  <ReadingProgressBar />
  <Header />
  
  <main id="main-content" class="pt-32 px-6 md:px-12 pb-20 max-w-4xl mx-auto">
    <article>
      <header class="mb-12 text-center">
        <div class="font-label text-xs text-primary mb-4 tracking-[0.2em] uppercase">
          [ {essay.data.category} ]
        </div>
        <h1 class="text-5xl md:text-7xl font-bold italic tracking-tighter text-secondary mb-6">
          {essay.data.title}
        </h1>
        <p class="text-xl text-on-surface-variant leading-relaxed font-body mb-8">
          {essay.data.description}
        </p>
        <div class="flex items-center justify-center space-x-4 font-label text-xs uppercase tracking-widest text-secondary">
          <span>By {essay.data.author}</span>
          <span>&bull;</span>
          <time datetime={essay.data.pubDate.toISOString()}>
            {essay.data.pubDate.toLocaleDateString('en-US', {
              timeZone: 'UTC',
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
        </div>
      </header>

      <div class="max-w-3xl mx-auto mb-16 group">
        <div class="aspect-video overflow-hidden border-2 border-secondary bg-surface-container-lowest">
          <EditorialImage
            src={sourceImagePath}
            alt={essay.data.imageAlt}
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            sizes="(max-width: 768px) 100vw, 768px"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>

      <Prose variant="essay">
        <Content components={components} />
      </Prose>
      
      {essay.data.tags.length > 0 && (
        <div class="mt-16 pt-8 border-t-2 border-secondary flex flex-wrap gap-2">
          {essay.data.tags.map((tag: string) => (
            <span class="font-label text-[10px] uppercase tracking-widest border border-secondary px-3 py-1 text-secondary">
              #{tag}
            </span>
          ))}
        </div>
      )}

      <div class="mt-12 pt-8 border-t border-outline-variant text-center">
        <a href="/essays/" class="font-label text-xs text-primary uppercase tracking-widest hover:text-secondary transition-colors">
          &lt;- Back to Essays
        </a>
      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>
