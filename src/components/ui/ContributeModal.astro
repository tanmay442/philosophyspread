---
import Icon from './Icon.astro';

const backdropClass = 'modal-backdrop bg-primary/80 backdrop-blur-sm p-4 md:p-8 border-none';
const contentClass =
  'modal-content relative w-full max-w-2xl lg:max-w-3xl bg-surface-container-lowest border-2 border-secondary rounded-lg shadow-2xl overflow-hidden max-h-[90vh] overflow-y-auto';
const closeButtonClass =
  'modal-close absolute top-3 right-3 p-2 rounded hover:bg-primary hover:text-on-primary transition-colors z-10';
const featureCardClass =
  'block p-4 rounded border-2 border-secondary/30 hover:bg-primary hover:text-on-primary transition-all group no-underline hover:no-underline focus:no-underline';
const featureIconWrapClass = 'p-2 rounded bg-primary/10 border border-secondary/30';
const featureTitleClass = 'font-medium group-hover:text-on-primary transition-colors';
const featureDescClass = 'text-sm text-secondary/70 group-hover:text-on-primary/80 transition-opacity';
const featureCtaClass = 'flex items-center gap-1 mt-2 text-secondary text-sm group-hover:text-on-primary';
const coffeeButtonClass =
  'inline-flex items-center gap-2 px-4 py-2 rounded bg-primary-container text-secondary font-bold hover:bg-primary hover:text-on-primary transition-colors no-underline hover:no-underline focus:no-underline';
const contributeLinkClass =
  'inline-flex items-center gap-2 text-sm text-secondary hover:text-primary transition-colors no-underline hover:no-underline focus:no-underline';
---

<dialog 
  id="contribute-modal"
  class={backdropClass}
>
  <div class={contentClass}>
    <button 
      class={closeButtonClass}
      aria-label="Close"
    >
      <Icon name="close" class="w-5 h-5" />
    </button>

    <div class="p-6 md:p-8 text-center bg-gradient-to-br from-primary-container to-tertiary-container">
      <div class="flex justify-center mb-3">
        <div class="p-4 rounded-full bg-primary/10 border border-secondary/30">
          <Icon name="favorite" class="h-8 w-8 text-primary" />
        </div>
      </div>
      <h3 class="font-headline text-2xl md:text-3xl mb-2 text-secondary">
        Support Our Initiative
      </h3>
      <p class="text-secondary/80 text-base md:text-lg">
        Your support helps us keep the philosophical journey alive
      </p>
    </div>
   
    <div class="p-6 md:p-8 pt-4 space-y-6">
      <div class="space-y-4 text-center">
        <p class="text-secondary/90 leading-relaxed">
          We appreciate your enthusiasm to join our philosophical journey. Your support reflects the spirit of curiosity and collaborative learning we value.
        </p>
        <div class="flex flex-col items-center gap-3 pt-4">
        <a href="/contribute" class={contributeLinkClass}>
          <Icon name="description" class="h-4 w-4" />
          Learn how to contribute to the content
        </a>
      </div> 
        <div class="p-4 md:p-6 rounded-lg bg-primary-container/50 border-2 border-secondary/30 flex flex-col lg:flex-row items-center gap-6 lg:gap-8">
          <div class="flex-1 text-left">
            <p class="text-secondary font-medium mb-2 flex items-center gap-2">
              <span class="text-xl">☕</span> Support via Buy Me a Coffee
            </p>
            <p class="text-sm text-secondary/80 mb-4">
              If you find value in our work, consider supporting us. Your contribution goes directly towards maintaining the platform and creating more deep-dive content.
            </p>
            <a 
              href="https://buymeacoffee.com/gtanmay" 
              target="_blank"
              rel="noopener noreferrer"
              class={coffeeButtonClass}
            >
              <img src="https://cdn.buymeacoffee.com/buttons/bmc-new-btn-logo.svg" alt="Buy Me a Coffee" class="h-5 w-5" />
              <span>Buy me a coffee</span>
            </a>
          </div>
          
          <div class="w-40 h-40 md:w-48 md:h-48 bg-surface-container-lowest rounded p-2 flex items-center justify-center border-2 border-secondary/30 flex-shrink-0">
            <img 
              src="/bmc_qr.png" 
              alt="Buy Me a Coffee QR Code" 
              class="w-full h-full object-contain"
            />
          </div>
        </div>

        <p class="text-secondary/90 leading-relaxed text-sm">
          Meanwhile, explore our resources. Every contributor starts as a learner, and your growth will enrich our community.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/logic-modules" class={featureCardClass}>
          <div class="flex items-center gap-3 mb-2">
            <div class={featureIconWrapClass}>
              <Icon name="lightbulb" class="h-5 w-5 text-primary group-hover:text-on-primary" />
            </div>
            <h4 class={featureTitleClass}>
              Logic Modules
            </h4>
          </div>
          <p class={featureDescClass}>
            Master critical thinking and logical reasoning skills
          </p>
          <div class={featureCtaClass}>
            <span>Start learning</span>
            <Icon name="arrow_forward" class="h-3 w-3" />
          </div>
        </a>

        <a href="/essays" class={featureCardClass}>
          <div class="flex items-center gap-3 mb-2">
            <div class={featureIconWrapClass}>
              <Icon name="menu_book" class="h-5 w-5 text-primary group-hover:text-on-primary" />
            </div>
            <h4 class={featureTitleClass}>
              Explore Our Essays
            </h4>
          </div>
          <p class={featureDescClass}>
            Dive into profound philosophical insights and articles
          </p>
          <div class={featureCtaClass}>
            <span>Read more</span>
            <Icon name="arrow_forward" class="h-3 w-3" />
          </div>
        </a>
      </div>

      <div class="text-center pt-4 border-t-2 border-secondary/20">
        <p class="text-xs text-secondary/70 mb-3 italic">
          "The best way to find yourself is to lose yourself in the service of others." - Gandhi
        </p>
        <button class="modal-close px-6 py-2 border-2 border-secondary text-secondary hover:bg-primary hover:text-on-primary transition-colors">
          Continue Exploring
        </button>
      </div>
    </div>
  </div>
</dialog>

<style>
  .modal-backdrop {
    position: fixed;
    inset: 0;
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  .modal-backdrop[open],
  .modal-backdrop.show {
    opacity: 1;
    visibility: visible;
  }

  .modal-content {
    transform: scale(0.95) translateY(10px);
    transition: transform 0.2s ease;
  }

  .modal-backdrop[open] .modal-content,
  .modal-backdrop.show .modal-content {
    transform: scale(1) translateY(0);
  }

  .modal-backdrop::backdrop {
    background: rgba(26, 26, 26, 0.8);
  }

  @media (max-width: 640px) {
    .modal-content {
      max-width: calc(100% - 1rem);
    }
  }
</style>

<script>
  const modal = document.getElementById('contribute-modal') as HTMLDialogElement;
  const openButtons = document.querySelectorAll('[data-modal="contribute"]');
  const closeButtons = modal?.querySelectorAll('.modal-close');

  openButtons?.forEach((btn) => {
    btn.addEventListener('click', () => {
      modal?.showModal();
    });
  });

  closeButtons?.forEach((btn) => {
    btn.addEventListener('click', () => {
      modal?.close();
    });
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.close();
    }
  });

  modal?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      modal.close();
    }
  });
</script>
