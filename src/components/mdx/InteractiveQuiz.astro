---
import { buildQuizKey } from '../../utils/quiz';

interface Question {
  question: string;
  options: string[];
  correctIndex: number;
  feedback: string;
}

interface Props {
  id: string;
  questions: Question[];
}

const { id, questions } = Astro.props;
const letters = ['A', 'B', 'C', 'D', 'E', 'F'];
const quizKey = buildQuizKey(id, questions);
---

<div class="my-12 space-y-12 quiz-container">
  {questions.map((q, qIndex) => (
    <div
      class="border-2 border-outline p-8 bg-surface-container-lowest relative question-block"
      data-question-index={qIndex}
      role="group"
      aria-labelledby={`quiz-${quizKey}-question-${qIndex}`}
    >
      <div aria-hidden="true" class="absolute -top-3 -left-3 bg-primary text-on-primary font-label text-xs px-3 py-1 border-2 border-outline">
        Q{qIndex + 1}
      </div>
      
      <h3 id={`quiz-${quizKey}-question-${qIndex}`} class="font-headline text-2xl mb-6 text-on-surface" set:html={q.question}></h3>
      
      <div class="space-y-3 options-container">
        {q.options.map((opt, oIndex) => (
          <button 
            type="button"
            class="w-full text-left border-2 border-outline p-4 flex items-center motion-safe:transition-all motion-safe:duration-200 motion-safe:ease-in-out motion-safe:transform motion-safe:hover:scale-[1.02] hover:bg-surface-container-low option-btn group cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            data-correct={oIndex === q.correctIndex ? 'true' : 'false'}
            aria-describedby={`quiz-${quizKey}-feedback-${qIndex}`}
          >
            <span class="font-label text-xs text-primary w-8 shrink-0 group-hover:scale-110 transition-transform option-letter">{letters[oIndex]}.</span>
            <span class="font-body text-lg text-on-surface" set:html={opt}></span>
          </button>
        ))}
      </div>
      
      <div class="hidden explanation-template" aria-hidden="true" set:html={q.feedback}></div>

      <div id={`quiz-${quizKey}-feedback-${qIndex}`} class="mt-4 p-4 text-sm hidden motion-safe:transition-all motion-safe:duration-300 feedback-container" role="status" aria-live="polite" aria-atomic="true">
        <span class="feedback-content font-body text-base"></span>
      </div>
    </div>
  ))}
</div>

<script>
  document.querySelectorAll('.quiz-container').forEach(container => {
    const questions = container.querySelectorAll('.question-block');
    
    questions.forEach(q => {
      const options = q.querySelectorAll('.option-btn');
      const feedback = q.querySelector('.feedback-container');
      const feedbackContent = q.querySelector('.feedback-content');
      const explanationTemplate = q.querySelector('.explanation-template');

      if (!feedback || !feedbackContent || !explanationTemplate) {
        return;
      }

      const explanationHtml = explanationTemplate.innerHTML;
      
      let isAnsweredCorrectly = false;

      const baseClasses = ['border-outline', 'hover:bg-surface-container-low'];
      const correctClasses = ['bg-primary-container', 'border-primary', 'text-secondary', 'font-bold'];
      const wrongClasses = ['bg-tertiary-container', 'border-tertiary', 'text-secondary'];
      
      options.forEach(opt => {
        opt.addEventListener('click', () => {
          if (isAnsweredCorrectly) return; 
          
          options.forEach(o => {
            o.classList.remove(...correctClasses, ...wrongClasses);
            o.classList.add(...baseClasses);
            
            const letter = o.querySelector('.option-letter');
            if(letter) {
              letter.classList.remove('text-tertiary');
              letter.classList.add('text-primary');
            }
          });

          const isCorrect = opt.getAttribute('data-correct') === 'true';
          const currentLetter = opt.querySelector('.option-letter');
          
          if (isCorrect) {
            isAnsweredCorrectly = true;
            
            opt.classList.remove(...baseClasses);
            opt.classList.add(...correctClasses);
            if (currentLetter) {
              // Flip the letter to the highlighted container's text color
              // (text-secondary is part of correctClasses) so it matches the
              // green primary-container background. Previously this removed
              // then re-added 'text-primary', leaving the letter unchanged.
              currentLetter.classList.remove('text-primary', 'text-tertiary');
              currentLetter.classList.add('text-secondary');
            }
            
            feedback.className = 'mt-4 p-4 text-sm block transition-all duration-300 bg-primary-container text-secondary feedback-container';
            feedbackContent.innerHTML = explanationHtml;
            
            options.forEach(o => {
              (o as HTMLButtonElement).disabled = true;
              o.classList.remove('cursor-pointer', 'motion-safe:hover:scale-[1.02]', 'hover:bg-surface-container-low');
              o.classList.add('cursor-not-allowed');
            });
          } else {
            opt.classList.remove(...baseClasses);
            opt.classList.add(...wrongClasses);
            if (currentLetter) {
              currentLetter.classList.remove('text-primary');
              currentLetter.classList.add('text-tertiary');
            }
            
            feedback.className = 'mt-4 p-4 text-sm block transition-all duration-300 bg-tertiary-container text-secondary feedback-container';
            feedbackContent.textContent = 'Not quite. Think about the structure and truth of the premises, then try again!';
          }
        });
      });
    });
  });
</script>
