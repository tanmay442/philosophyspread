---
import type { CollectionEntry } from 'astro:content';
import HeroBlock from '../cards/HeroBlock.astro';
import { truncateText } from '../../utils/text';

interface Props {
  latestLogic?: CollectionEntry<'logicModules'>;
  latestBit?: CollectionEntry<'bits'>;
  latestEssay?: CollectionEntry<'essays'>;
}

const { latestLogic, latestBit, latestEssay } = Astro.props;
---

<div class="md:col-span-4 flex flex-col bg-surface-container-low">
  {latestLogic && (
    <HeroBlock 
      tag={`MODULE ${latestLogic.data.moduleNumber}`}
      title={latestLogic.data.title}
      description={latestLogic.data.description}
      bgClass="bg-primary-container"
      hoverBgClass="hover:bg-tertiary-container hover:-translate-y-1"
      href={`/logic-modules/${latestLogic.id}`}
    />
  )}
  
  {latestBit && (
    <HeroBlock 
      tag={`BIT ${latestBit.data.bitNumber}`}
      title={latestBit.data.category}
      description={truncateText(latestBit.data.content, 100)}
      bgClass="bg-surface-container-lowest"
      hoverBgClass="hover:bg-primary/10 hover:-translate-y-1"
      href={`/bits/${latestBit.id}`}
    />
  )}
  
  {latestEssay && (
    <HeroBlock 
      tag={`ESSAY`}
      title={latestEssay.data.title}
      description={latestEssay.data.description}
      bgClass="bg-tertiary"
      hoverBgClass="hover:bg-tertiary-container hover:-translate-y-1"
      href={`/essays/${latestEssay.id}`}
    />
  )}
</div>
