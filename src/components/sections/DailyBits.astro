---
import type { CollectionEntry } from 'astro:content';
import BitCard from '../cards/BitCard.astro';

interface Props {
  bits: CollectionEntry<'bits'>[];
}

const { bits } = Astro.props;
---

<section id="bits" class="py-24 px-8 md:px-12 bg-surface-container-low border-y-2 border-secondary">
  <div class="max-w-7xl mx-auto">
    <div class="flex justify-between items-end mb-12 md:mb-16">
      <div>
        <h2 class="font-headline text-5xl mb-4">Idea-Bits</h2>
        <p class="font-label text-sm text-secondary uppercase tracking-widest">Dense fragments of wisdom updated bi-weekly.</p>
      </div>
      <a href="/bits/page/1" class="hidden md:inline-block font-label text-xs bg-primary text-on-primary px-3 py-1 hover:bg-tertiary hover:text-on-tertiary transition-colors">LIVE FEED</a>
    </div>
    
    <div class="columns-1 md:columns-2 lg:columns-3 gap-8">
      {bits.map((bit: CollectionEntry<'bits'>) => (
        <BitCard
          tag={`#${bit.data.bitNumber} / ${bit.data.category.toUpperCase()}`}
          time={bit.data.timestamp.toLocaleString('en-US', { timeZone: 'UTC', dateStyle: 'medium', timeStyle: 'short' }) + ' UTC'}
          content={bit.data.content}
          href={`/bits/${bit.id}`}
        />
      ))}
    </div>

    <div class="mt-8 flex md:hidden justify-center">
      <a href="/bits/page/1" class="font-label text-xs bg-primary text-on-primary px-4 py-2 hover:bg-tertiary hover:text-on-tertiary transition-colors">LIVE FEED</a>
    </div>
  </div>
</section>
