---
import Icon from '../ui/Icon.astro';

const socialLinks = [
  {
    href: 'https://github.com/tanmay442/PhilosophySpread.git',
    label: 'GitHub',
    target: '_blank',
    path: 'M12 .5C5.73.5.5 5.74.5 12.02c0 5.1 3.29 9.42 7.86 10.95.58.1.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.55-3.88-1.55-.53-1.36-1.3-1.72-1.3-1.72-1.06-.73.08-.71.08-.71 1.17.08 1.79 1.2 1.79 1.2 1.04 1.78 2.73 1.27 3.4.97.1-.76.41-1.27.74-1.56-2.55-.29-5.23-1.28-5.23-5.68 0-1.25.45-2.27 1.2-3.07-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.18 1.17.92-.26 1.9-.39 2.88-.39.98 0 1.96.13 2.88.39 2.2-1.48 3.17-1.17 3.17-1.17.64 1.58.24 2.75.12 3.04.75.8 1.2 1.82 1.2 3.07 0 4.41-2.69 5.39-5.25 5.68.42.36.79 1.08.79 2.18 0 1.57-.01 2.83-.01 3.21 0 .31.2.67.8.56 4.57-1.53 7.85-5.85 7.85-10.95C23.5 5.74 18.27.5 12 .5z',
  },
  {
    href: 'https://x.com/TanmayGoel442',
    label: 'Twitter/X',
    target: '_blank',
    path: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z',
  },
  {
    href: '/authors',
    label: 'Contributors',
    target: '_self',
    path: 'M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z',
  },
];
---

<footer class="relative bg-surface-container-low px-6 py-14 md:px-12">
  <div class="mx-auto max-w-[1400px]">
    
    <!-- Top Section: Logo & Columns Layout -->
    <div class="flex flex-col gap-12 lg:flex-row lg:justify-between lg:gap-6">
      
      <!-- Logo Column -->
      <div class="flex-shrink-0 lg:w-1/4 flex justify-center lg:justify-start">
        <img 
          src="/favicon.svg" 
          alt="Philosophy Spread logo" 
          class="h-28 w-28 md:h-32 md:w-32 object-contain" 
          loading="lazy" 
        />
      </div>

      <!-- Links Grid (Now 3 columns since About Us is removed) -->
      <div class="grid w-full grid-cols-1 gap-8 sm:grid-cols-3 lg:w-3/4 text-center sm:text-left">
        
        <!-- CLASSICAL LOGIC -->
        <div class="space-y-4">
          <h2 class="font-headline text-base md:text-lg uppercase tracking-wider text-primary">Classical Logic</h2>
          <ul class="flex flex-col space-y-3">
            <li>
              <a href="/logic-modules/module01-propositions" class="font-body text-sm text-secondary/80 transition-all hover:text-primary">
                Module 01: Propositions
              </a>
            </li>
            <li>
              <a href="/logic-modules/module02-validity" class="font-body text-sm text-secondary/80 transition-all hover:text-primary">
                Module 02: Validity
              </a>
            </li>
            <li>
              <a href="/logic-modules/module03-cogencyandanalogy" class="font-body text-sm text-secondary/80 transition-all hover:text-primary">
                Module 03: Cogency and Analogy
              </a>
            </li>
          </ul>
        </div>

        <!-- IDEA BITS & BLOGS -->
        <div class="space-y-4">
          <h2 class="font-headline text-base md:text-lg uppercase tracking-wider text-primary">Philosophical Reads</h2>
          <ul class="flex flex-col space-y-3">
            <li>
              <a href="/bits" class="font-body text-sm text-secondary/80 transition-all hover:text-primary">
                Idea Bits
              </a>
            </li>
            <li>
              <a href="/essays" class="font-body text-sm text-secondary/80 transition-all hover:text-primary">
                Blog
              </a>
            </li>
          </ul>
        </div>

        <!-- FOLLOW US -->
        <div class="space-y-4">
          <h2 class="font-headline text-base md:text-lg uppercase tracking-wider text-primary">Follow Us</h2>
          <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2 font-body text-sm text-secondary/80">
            {socialLinks.map((link, index) => (
              <div class="flex items-center gap-2">
                <a 
                  href={link.href} 
                  target={link.target} 
                  rel={link.target === '_blank' ? "noreferrer" : ""} 
                  class="flex items-center gap-1.5 transition-all hover:text-primary"
                >
                  <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
                    <path d={link.path}></path>
                  </svg>
                  <span>{link.label}</span>
                </a>
                {index < socialLinks.length - 1 && <span class="text-secondary/50">/</span>}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Section: Centered details -->
    <div class="mt-16 flex flex-col items-center space-y-4 text-center">
      
      <!-- Description Paragraph -->
      <p class="max-w-3xl font-body text-xs leading-relaxed text-on-surface-variant opacity-90 md:text-sm">
        Philosophy Spread is aiming to spread wisdom and inspire change. This journey begins with a simple effort to make philosophical insights more accessible, fostering a more thoughtful and critical community.
      </p>

      <!-- Sub-links (Combined Privacy & Terms, alongside Contribute) -->
      <div class="font-body text-xs text-secondary/80 space-x-2">
        <a href="/terms" class="hover:text-primary hover:underline">Terms & Privacy Policy</a>
        <span class="text-secondary/50">|</span>
        <a href="/contribute" class="hover:text-primary hover:underline">How to Contribute</a>
      </div>

      <!-- Copyright -->
      <p class="font-body text-xs text-on-surface-variant opacity-80">
        © 2025 Philosophy Spread Ltd. Aiming to foster a thoughtful world.
      </p>
    </div>
  </div>

  <!-- Scroll to Top -->
  <a
    href="#"
    class="absolute bottom-6 right-6 z-10 flex h-10 w-10 items-center justify-center rounded-full border-2 border-secondary bg-primary text-on-primary transition-colors hover:bg-tertiary hover:text-on-tertiary"
    aria-label="Scroll to top"
  >
    <Icon name="arrow_upward" class="block h-5 w-5" />
  </a>
</footer>