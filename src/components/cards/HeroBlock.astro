---
import type { HTMLAttributes } from 'astro/types';
import SectionTag from '../ui/SectionTag.astro';

type CommonProps = {
  tag: string;
  title: string;
  description: string;
  bgClass: string;
  hoverBgClass: string;
  hoverTextClass?: string;
  class?: string;
};

type AnchorProps = HTMLAttributes<'a'> & CommonProps & { href: string };
type DivProps = HTMLAttributes<'div'> & CommonProps & { href?: never };

type Props = AnchorProps | DivProps;

const props = Astro.props as Props;
const {
  tag,
  title,
  description,
  bgClass,
  hoverBgClass,
  hoverTextClass = '',
  class: className,
  ...rest
} = props;
const href = 'href' in props ? props.href : undefined;

const blockClass = `block flex-1 p-8 border-b-2 border-secondary transition-all duration-300 group no-underline hover:no-underline focus:no-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-primary ${href ? 'cursor-pointer' : ''} ${bgClass} ${hoverBgClass} ${hoverTextClass} ${className ?? ''}`.trim();
// The orange hero panel is too close to the green accent for small label text.
// Use the secondary ink there while preserving the accent on the lighter panels.
const tagColorClass = bgClass.includes('bg-tertiary') ? 'text-secondary' : 'text-primary';
const tagClass = `block mb-4 ${tagColorClass} ${hoverTextClass ? 'group-hover:text-on-primary transition-colors' : ''}`;
const descriptionClass = `font-body text-lg opacity-80 ${hoverTextClass ? 'group-hover:opacity-100' : ''}`;

// Fallow dup:d9ffbf4e: the <a> and <div> branches below share identical inner content by design.
// Only the wrapper element differs (link vs non-link). Extracting a sub-component for 3 lines of
// static markup would add indirection without meaningful dedup value.
// Listed in .github/workflows/build-fallow.yml as a known-intentional clone group (CI fingerprint filter).
---

{href ? (
  <a href={href} class={blockClass} {...rest}>
    <SectionTag class={tagClass}>{tag}</SectionTag>
    <h2 class="font-headline text-3xl mb-4 group-hover:italic">{title}</h2>
    <p class={descriptionClass}>{description}</p>
  </a>
) : (
  <div class={blockClass} {...rest}>
    <SectionTag class={tagClass}>{tag}</SectionTag>
    <h2 class="font-headline text-3xl mb-4 group-hover:italic">{title}</h2>
    <p class={descriptionClass}>{description}</p>
  </div>
)}
