---
import Icon from '../ui/Icon.astro';
---

<div class="md:ml-12 bg-primary-container border-2 border-secondary p-8 transition-all hover:bg-tertiary-container group">
  <a href="mailto:goeltanmay442@outlook.com" class="block">
    <span class="font-label text-[10px] text-secondary font-bold tracking-widest uppercase">Contribute</span>
    <h3 class="font-headline text-2xl group-hover:italic mt-2 text-primary">SUBMIT YOUR ESSAY</h3>
    <p class="font-body text-lg opacity-70 mt-2">Have a unique perspective? Share your ideas with the community of modern thinkers.</p>
  </a>
  <a href="/contribute/" class="inline-flex items-center gap-1 mt-4 text-xs font-label text-secondary hover:text-primary transition-colors">
    <span>Read contribution guidelines</span>
    <Icon name="arrow_forward" class="h-4 w-4" />
  </a>
</div>
